MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 501818241}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ebea2d571e2b4df48b258230cb96b240, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::prolog
  chapters:
  - backgroundImage: {fileID: -7223346133464218232, guid: ec671ab324ab77a4e8947ba0b8a16e46,
      type: 3}
    dialogueText: "Selama ratusan tahun, Kerajaan Numerica hidup damai. Tidak ada
      perang. Tidak ada monster. Para kesatria hanya berjaga-jaga\u2026 dari kebosanan."
  - backgroundImage: {fileID: 2726526546212396937, guid: 1ae55afb673faff45bffc604c5918e99,
      type: 3}
    dialogueText: Suatu pagi, tanah di tengah alun-alun retak. Sebuah pintu batu
      hitam muncul entah dari mana.
  - backgroundImage: {fileID: -2097398342024400353, guid: b991dd74278665843b57b013b1a24772,
      type: 3}
    dialogueText: 'Raja memanggil satu-satunya kesatria yang sedang tidak sibuk:
      kamu.'
  - backgroundImage: {fileID: -8667364522630866421, guid: 257aefc98bec9a24ab5e4d21513e6a04,
      type: 3}
    dialogueText: '"Masuklah. Lihat apa yang ada di dalam. Lalu cepat kembali." Kamu
      mengangguk. Ini tampak mudah'
  - backgroundImage: {fileID: 5135759757349014696, guid: 43a147fb95714094486d53456a1c49da,
      type: 3}
    dialogueText: Kau berdiri di depan pintu dungeon. Satu kaki melangkah masuk...
  - backgroundImage: {fileID: -6997563736588212934, guid: bbc94b4a3ce07684688da2fb43e330ce,
      type: 3}
    dialogueText: Begitu kau masuk sepenuhnya, pintu di belakangmu menutup sendiri.
      Terkunci. Tidak bisa didorong. Tidak bisa dirusak. Kini kau terjebak di dalam
      dungeon
  backgroundImageUI: {fileID: 1052561044}
  dialogueTextUI: {fileID: 451862248}
  nextButton: {fileID: 0}
  typingSpeed: 0.05
  nextSceneName: game
